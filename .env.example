# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────
# Database
# Railway Postgres injects DATABASE_URL automatically when linked
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/xenysis

# ─────────────────────────────────────────
# Auth (JWT + Google OAuth)
# JWT_SECRET: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GOOGLE_REDIRECT_URI: API callback URL (e.g. http://localhost:3001/api/v1/auth/google/callback)
# FRONTEND_URL: Frontend origin for auth redirects and email links
# ─────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────
# Security
# CORS_ORIGINS: Comma-separated list of allowed frontend origins
# ENCRYPTION_KEY: 32-byte hex string for AES-256-GCM (Sprint 5 — deploy env vars)
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=

# ─────────────────────────────────────────
# AI Providers — Sprint 2+
# ANTHROPIC_API_KEY: BlueprintAgent, WorkspaceAgent
# OPENAI_API_KEY: OpportunityAgent, Founder Session interactions
# Both are server-side only — never in NEXT_PUBLIC_* frontend variables
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────
# Email — Resend
# RESEND_API_KEY: API key from resend.com
# EMAIL_FROM: "Name <address>" — must use a verified domain in Resend
# ADMIN_SECRET_KEY: Passed as X-Admin-Key header to access admin endpoints
# ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Xenysis <noreply@xenysis.com>"
ADMIN_SECRET_KEY=

# ─────────────────────────────────────────
# Founder Session
# MAX_SESSION_ANSWERS: Maximum Q&A answers per session. Default 100.
#   Summarization handles context growth — raise freely; token cost is
#   driven by prompt size, not answer count.
# ─────────────────────────────────────────
MAX_SESSION_ANSWERS=100
